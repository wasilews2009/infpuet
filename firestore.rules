rules_version = '2';

// Правила безпеки бази «База знань ІЦ ПУЕТ».
// Опублікуйте їх у Firebase: Firestore Database → Rules → вставити цей текст → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function authPath() { return /databases/$(database)/documents/auth/$(request.auth.uid); }
    function hasAccount() { return request.auth != null && exists(authPath()); }
    function acc() { return get(authPath()).data; }
    function signed() { return hasAccount() && acc().active == true; }
    function editor() { return signed() && acc().role in ['admin', 'editor']; }
    function admin() { return signed() && acc().role == 'admin'; }

    // Перший запуск: адміністратор і позначка meta/setup створюються одним пакетом.
    function firstSetup() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup)
        && getAfter(authPath()).data.role == 'admin';
    }

    match /meta/setup {
      allow read: if true;
      allow create: if firstSetup();
    }

    // Відповідність «логін → службова адреса для входу». Читається до входу.
    match /logins/{login} {
      allow read: if true;
      allow write: if admin() || firstSetup();
    }

    // Права облікового запису Firebase: роль і стан.
    match /auth/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || admin());
      allow create: if admin() || (firstSetup() && request.auth.uid == uid);
      allow update, delete: if admin();
    }

    match /users/{id} {
      allow read: if signed();
      allow write: if admin() || firstSetup();
    }

    // Чати: особисту розмову бачать лише її учасники (і адміністратор для резервної копії).
    // Теми форуму бачать усі користувачі.
    match /talk/{id} {
      function mine(d) { return d.kind == 'topic' || d.a == acc().uid || d.b == acc().uid; }
      allow read: if signed() && (admin() || resource == null || mine(resource.data));
      allow create: if signed() && (admin() || mine(request.resource.data));
      allow update: if signed() && (admin() || mine(resource.data));
      allow delete: if signed() && (admin() || (resource.data.kind == 'topic' && resource.data.by == acc().uid));
    }

    match /log/{day} {
      allow read: if signed();
      allow write: if editor();
    }

    match /meta/{id} {
      allow read: if signed();
      allow write: if editor() && id != 'setup';
    }

    match /{col}/{id} {
      allow read: if signed() && col in ['rooms', 'equipment', 'repairs', 'stock', 'software'];
      allow write: if editor() && col in ['rooms', 'equipment', 'repairs', 'stock', 'software'];
    }
  }
}
